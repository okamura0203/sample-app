{
  "family": "sample-app-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::831313446054:role/sample-app-task-execution-role",
  "taskRoleArn": "arn:aws:iam::831313446054:role/sample-app-task-role",
  "containerDefinitions": [
    {
      "name": "sample-app",
      "image": "831313446054.dkr.ecr.ap-northeast-1.amazonaws.com/okamuras-kitchen:latest",
      "portMappings": [{ "containerPort": 80, "protocol": "tcp" }],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sample-app",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true
    }
  ],
  "runtimePlatform": {
      "operatingSystemFamily": "LINUX",
      "cpuArchitecture": "ARM64"
  },
  "portMappings": [
    {
      "containerPort": 80,
      "protocol": "Protocol.TCP"
    }
  ],
  "environment": {
    "NODE_ENV": "prod"
  },
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}
