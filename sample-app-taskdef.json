{
  "family": "sample-app-prod-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "executionRoleArn": "arn:aws:iam::361986022123:role/sample-app-prod-task-execution-role",
  "taskRoleArn": "arn:aws:iam::361986022123:role/sample-app-prod-task-role",
  "containerDefinitions": [
    {
      "name": "sample-app",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "prod" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sample-app-prod",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "sample-app-prod"
        }
      }
    }
  ]
}
